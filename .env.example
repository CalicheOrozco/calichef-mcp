# Public URL of this MCP server, no trailing slash
BASE_URL=https://calichef-mcp.vercel.app/
# Calichef app whose API and recipe data this server uses
APP_URL=https://calichef.netlify.app
# Database for OAuth clients and tokens (can be the same cluster as the app)
MONGODB_URI=
MCP_DB=calichef-mcp
# Random string, 32+ characters. Generate with: openssl rand -base64 48
MCP_SECRET=